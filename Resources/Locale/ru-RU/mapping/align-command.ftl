cmd-align-desc =
    Автоматически поворачивает все закреплённые шлюзы, двери, пожарные шлюзы и другие совместимые сущности,
    выравнивая их по соседним конструкциям.

    Используйте параметр пробного запуска, чтобы выполнить проверку без поворота сущностей.
cmd-align-help = Использование: { $command } [ID карты] [пробный запуск?]
cmd-align-no-release = Эту команду нельзя использовать, если игра запущена в конфигурации RELEASE.
cmd-align-hint-id = ID карты
cmd-align-hint-dry = пробный запуск?
cmd-align-feedback-none = { $dry ->
    [true] ПРОБНЫЙ ЗАПУСК: не найдено
    *[false] Не найдено
    } сущностей, совместимых с AlignerSystem!
cmd-align-feedback-good = { $dry ->
    [true] ПРОБНЫЙ ЗАПУСК: неверно ориентированных сущностей не найдено.
    *[false] Неверно ориентированных сущностей не найдено.
    }
cmd-align-feedback = { $dry ->
    [true] ПРОБНЫЙ ЗАПУСК: { $fixed ->
        [one] найдена одна неверно ориентированная сущность.
        [few] найдены { $fixed } неверно ориентированные сущности.
        *[other] найдено { $fixed } неверно ориентированных сущностей.
        }
    *[false] { $fixed ->
        [one] Найдена и исправлена одна неверно ориентированная сущность.
        [few] Найдены и исправлены { $fixed } неверно ориентированные сущности.
        *[other] Найдено и исправлено { $fixed } неверно ориентированных сущностей.
        }
    }
