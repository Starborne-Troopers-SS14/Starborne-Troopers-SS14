st14-weather-chat = [color=#E8A040][bold]Weather:[/bold][/color] {$message}

st14-weather-sandstorm = Sandstorm
st14-weather-sandstorm-warning = A sandstorm is closing in! Visibility drops and the sand cuts the skin.
st14-weather-sandstorm-over = The storm has passed, the sand settles.
st14-weather-sandstorm-hurt = The sand cuts your skin.

st14-weather-thunderstorm = Thunderstorm
st14-weather-thunderstorm-warning = A thunderstorm breaks! Lightning strikes the ground.
st14-weather-thunderstorm-over = The thunderstorm has moved on.

st14-weather-dry-storm = Dry thunderstorm
st14-weather-dry-storm-warning = A dry thunderstorm: wind and lightning without a drop of rain!
st14-weather-dry-storm-over = The dry thunderstorm has passed.

st14-weather-rain = Downpour
st14-weather-rain-warning = A downpour begins.
st14-weather-rain-over = The rain has stopped.

st14-weather-gale = Gale
st14-weather-gale-warning = A gale is rising! Keep your footing!
st14-weather-gale-over = The wind has died down.
st14-weather-gust-fall = A gust of wind knocks you down!

st14-weather-heatwave = Heatwave
st14-weather-heatwave-warning = The star stands at its zenith and the air is scorching: a heatwave begins.
st14-weather-heatwave-over = The heat has eased.
st14-weather-heatwave-hurt = The heat bakes you.

st14-weather-cold = Freezing night
st14-weather-cold-warning = The night freezes the desert: frost and snow!
st14-weather-cold-over = The frost has eased.
st14-weather-cold-hurt = The cold chills you to the bone.

st14-weather-command-description = Weather and time of day of the sector you stand in.
st14-weather-command-help = st14_weather list | stop | status | hour <0-24> | <event> [seconds] [full]
st14-weather-command-arg = <event | list | stop | status | hour>
st14-weather-command-no-sector = You are not on a sector map.
st14-weather-command-stopped = The event has been stopped.
st14-weather-command-none = There is no event here right now.
st14-weather-command-hour = The star has moved: it is now {$hour} h in this sector.
st14-weather-command-status = Height of the star: {$height}, event: {$event}
st14-weather-command-unknown = There is no event {$id}.
st14-weather-command-started = Started: {$name}.
